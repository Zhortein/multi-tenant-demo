{% extends 'base.html.twig' %}

{% block title %}Notifications - {{ tenant.name }}{% endblock %}

{% use '_tenant_navigation.html.twig' %}

{% block body %}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>
                    <i class="bi bi-bell me-2"></i>
                    Notifications
                    <small class="text-muted">{{ tenant.name }}</small>
                </h1>
                <div>
                    <a href="{{ path('tenant_notification_create', {tenantSlug: tenant.slug}) }}" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-1"></i>
                        Create Notification
                    </a>
                </div>
            </div>

            <!-- Notification Statistics -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card bg-primary text-white">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <h4 class="card-title">{{ stats.total }}</h4>
                                    <p class="card-text">Total</p>
                                </div>
                                <div class="align-self-center">
                                    <i class="bi bi-bell fs-1"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-warning text-white">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <h4 class="card-title">{{ stats.unread }}</h4>
                                    <p class="card-text">Unread</p>
                                </div>
                                <div class="align-self-center">
                                    <i class="bi bi-bell-fill fs-1"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-success text-white">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <h4 class="card-title">{{ stats.sent }}</h4>
                                    <p class="card-text">Sent</p>
                                </div>
                                <div class="align-self-center">
                                    <i class="bi bi-check-circle fs-1"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-danger text-white">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <h4 class="card-title">{{ stats.failed }}</h4>
                                    <p class="card-text">Failed</p>
                                </div>
                                <div class="align-self-center">
                                    <i class="bi bi-x-circle fs-1"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Test Functions -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-gear me-2"></i>
                        Test Functions
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <form method="post" action="{{ path('tenant_notification_test', {tenantSlug: tenant.slug}) }}" class="mb-2">
                                <button type="submit" class="btn btn-outline-info w-100">
                                    <i class="bi bi-bell me-1"></i>
                                    Test Basic Notification
                                </button>
                            </form>
                            <small class="text-muted">Creates a simple test notification</small>
                        </div>
                        <div class="col-md-4">
                            <form method="post" action="{{ path('tenant_notification_test_messenger', {tenantSlug: tenant.slug}) }}" class="mb-2">
                                <button type="submit" class="btn btn-outline-warning w-100">
                                    <i class="bi bi-arrow-repeat me-1"></i>
                                    Test Messenger Queue
                                </button>
                            </form>
                            <small class="text-muted">Creates 5 notifications via Messenger</small>
                        </div>
                        <div class="col-md-4">
                            <div class="input-group mb-2">
                                <input type="email" class="form-control form-control-sm" id="testEmail" placeholder="test@example.com">
                                <button type="button" class="btn btn-outline-success btn-sm" onclick="testEmail()">
                                    <i class="bi bi-envelope me-1"></i>
                                    Test Email
                                </button>
                            </div>
                            <small class="text-muted">Sends a test email notification</small>
                        </div>
                    </div>
                </div>
            </div>

            {% if notifications is empty %}
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    No notifications found for this tenant. 
                    <a href="{{ path('tenant_notification_create', {tenantSlug: tenant.slug}) }}" class="alert-link">Create your first notification</a>.
                </div>
            {% else %}
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="bi bi-list me-2"></i>
                            Notification List ({{ notifications|length }} notifications)
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Status</th>
                                        <th>Title</th>
                                        <th>Type</th>
                                        <th>Recipient</th>
                                        <th>Created</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for notification in notifications %}
                                        <tr class="{% if not notification.isRead and notification.sendInApp %}table-warning{% endif %}">
                                            <td>
                                                <div class="d-flex flex-column">
                                                    {% if notification.status == 'sent' %}
                                                        <span class="badge bg-success mb-1">
                                                            <i class="bi bi-check-circle me-1"></i>Sent
                                                        </span>
                                                    {% elseif notification.status == 'failed' %}
                                                        <span class="badge bg-danger mb-1">
                                                            <i class="bi bi-x-circle me-1"></i>Failed
                                                        </span>
                                                    {% else %}
                                                        <span class="badge bg-warning mb-1">
                                                            <i class="bi bi-clock me-1"></i>Pending
                                                        </span>
                                                    {% endif %}
                                                    
                                                    {% if notification.sendInApp %}
                                                        {% if notification.isRead %}
                                                            <small class="text-muted">
                                                                <i class="bi bi-eye me-1"></i>Read
                                                            </small>
                                                        {% else %}
                                                            <small class="text-warning">
                                                                <i class="bi bi-eye-slash me-1"></i>Unread
                                                            </small>
                                                        {% endif %}
                                                    {% endif %}
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <i class="{{ notification.bootstrapIcon }} text-{{ notification.bootstrapClass }} me-2"></i>
                                                    <div>
                                                        <strong>{{ notification.title }}</strong>
                                                        <br><small class="text-muted">{{ notification.message|length > 50 ? notification.message|slice(0, 50) ~ '...' : notification.message }}</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-{{ notification.bootstrapClass }}">
                                                    {{ notification.type|title }}
                                                </span>
                                            </td>
                                            <td>
                                                {% if notification.recipientEmail %}
                                                    <i class="bi bi-envelope me-1"></i>
                                                    {{ notification.recipientEmail }}
                                                {% elseif notification.recipient %}
                                                    <i class="bi bi-person me-1"></i>
                                                    {{ notification.recipient.firstName }} {{ notification.recipient.lastName }}
                                                {% else %}
                                                    <span class="text-muted">System</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <small>
                                                    {{ notification.createdAt|date('M j, Y') }}<br>
                                                    <span class="text-muted">{{ notification.createdAt|date('g:i A') }}</span>
                                                </small>
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <a href="{{ path('tenant_notification_show', {tenantSlug: tenant.slug, id: notification.id}) }}" 
                                                       class="btn btn-outline-primary" title="View Details">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                    {% if not notification.isRead and notification.sendInApp %}
                                                        <form method="post" action="{{ path('tenant_notification_read', {tenantSlug: tenant.slug, id: notification.id}) }}" class="d-inline">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('read_notification_' ~ notification.id) }}">
                                                            <button type="submit" class="btn btn-outline-success" title="Mark as Read">
                                                                <i class="bi bi-check"></i>
                                                            </button>
                                                        </form>
                                                    {% endif %}
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<script>
function testEmail() {
    const email = document.getElementById('testEmail').value;
    if (!email) {
        alert('Please enter an email address');
        return;
    }
    
    const form = document.createElement('form');
    form.method = 'post';
    form.action = '{{ path('tenant_notification_test_email', {tenantSlug: tenant.slug}) }}';
    
    const emailInput = document.createElement('input');
    emailInput.type = 'hidden';
    emailInput.name = 'recipient_email';
    emailInput.value = email;
    
    form.appendChild(emailInput);
    document.body.appendChild(form);
    form.submit();
}
</script>
{% endblock %}