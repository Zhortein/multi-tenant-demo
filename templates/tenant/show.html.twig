{% extends 'base.html.twig' %}

{% block title %}{{ tenant.name }} - Tenant Details{% endblock %}

{% block body %}
<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1><i class="bi bi-building"></i> {{ tenant.name }}</h1>
                <div class="btn-group">
                    <a href="{{ path('admin_tenant_edit', {id: tenant.id}) }}" class="btn btn-primary">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    {% if tenant.active %}
                        <a href="{{ path('tenant_dashboard', {tenantSlug: tenant.slug}) }}" class="btn btn-success">
                            <i class="bi bi-arrow-right-circle"></i> Enter Tenant
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5><i class="bi bi-info-circle"></i> Tenant Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Name:</dt>
                        <dd class="col-sm-9">{{ tenant.name }}</dd>
                        
                        <dt class="col-sm-3">Slug:</dt>
                        <dd class="col-sm-9"><code>{{ tenant.slug }}</code></dd>
                        
                        {% if tenant.description %}
                            <dt class="col-sm-3">Description:</dt>
                            <dd class="col-sm-9">{{ tenant.description }}</dd>
                        {% endif %}
                        
                        {% if tenant.domain %}
                            <dt class="col-sm-3">Domain:</dt>
                            <dd class="col-sm-9">
                                <a href="{{ tenant.domain }}" target="_blank" class="text-decoration-none">
                                    {{ tenant.domain }} <i class="bi bi-box-arrow-up-right"></i>
                                </a>
                            </dd>
                        {% endif %}
                        
                        <dt class="col-sm-3">Status:</dt>
                        <dd class="col-sm-9">
                            {% if tenant.active %}
                                <span class="badge bg-success">Active</span>
                            {% else %}
                                <span class="badge bg-secondary">Inactive</span>
                            {% endif %}
                        </dd>
                        
                        <dt class="col-sm-3">Created:</dt>
                        <dd class="col-sm-9">{{ tenant.createdAt|date('F j, Y \\a\\t g:i A') }}</dd>
                        
                        {% if tenant.updatedAt %}
                            <dt class="col-sm-3">Last Updated:</dt>
                            <dd class="col-sm-9">{{ tenant.updatedAt|date('F j, Y \\a\\t g:i A') }}</dd>
                        {% endif %}
                    </dl>
                </div>
            </div>

            <!-- Users Section -->
            <div class="card mt-4">
                <div class="card-header">
                    <h5><i class="bi bi-people"></i> Users ({{ tenant.users|length }})</h5>
                </div>
                <div class="card-body">
                    {% if tenant.users is empty %}
                        <p class="text-muted">No users assigned to this tenant yet.</p>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Status</th>
                                        <th>Created</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for user in tenant.users %}
                                        <tr>
                                            <td>{{ user.fullName }}</td>
                                            <td>{{ user.email }}</td>
                                            <td>
                                                {% if user.active %}
                                                    <span class="badge bg-success">Active</span>
                                                {% else %}
                                                    <span class="badge bg-secondary">Inactive</span>
                                                {% endif %}
                                            </td>
                                            <td><small>{{ user.createdAt|date('M j, Y') }}</small></td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>

            <!-- Products Section -->
            <div class="card mt-4">
                <div class="card-header">
                    <h5><i class="bi bi-box"></i> Products ({{ tenant.products|length }})</h5>
                </div>
                <div class="card-body">
                    {% if tenant.products is empty %}
                        <p class="text-muted">No products created for this tenant yet.</p>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>SKU</th>
                                        <th>Price</th>
                                        <th>Stock</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for product in tenant.products|slice(0, 10) %}
                                        <tr>
                                            <td>{{ product.name }}</td>
                                            <td><code>{{ product.sku }}</code></td>
                                            <td>${{ product.price }}</td>
                                            <td>{{ product.stockQuantity }}</td>
                                            <td>
                                                {% if product.active %}
                                                    <span class="badge bg-success">Active</span>
                                                {% else %}
                                                    <span class="badge bg-secondary">Inactive</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                    {% if tenant.products|length > 10 %}
                                        <tr>
                                            <td colspan="5" class="text-center text-muted">
                                                <small>... and {{ tenant.products|length - 10 }} more products</small>
                                            </td>
                                        </tr>
                                    {% endif %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5><i class="bi bi-lightning"></i> Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="{{ path('admin_tenant_edit', {id: tenant.id}) }}" class="btn btn-primary">
                            <i class="bi bi-pencil"></i> Edit Tenant
                        </a>
                        {% if tenant.active %}
                            <a href="{{ path('tenant_dashboard', {tenantSlug: tenant.slug}) }}" class="btn btn-success">
                                <i class="bi bi-arrow-right-circle"></i> Enter Tenant
                            </a>
                            <a href="{{ path('tenant_product_index', {tenantSlug: tenant.slug}) }}" class="btn btn-outline-primary">
                                <i class="bi bi-box"></i> View Products
                            </a>
                        {% endif %}
                        <a href="{{ path('admin_tenant_index') }}" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                    </div>
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header">
                    <h5><i class="bi bi-bar-chart"></i> Statistics</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-6">
                            <h4 class="text-primary">{{ tenant.users|length }}</h4>
                            <small class="text-muted">Users</small>
                        </div>
                        <div class="col-6">
                            <h4 class="text-info">{{ tenant.products|length }}</h4>
                            <small class="text-muted">Products</small>
                        </div>
                    </div>
                    <hr>
                    <div class="row text-center">
                        <div class="col-6">
                            <h4 class="text-success">{{ tenant.users|filter(u => u.active)|length }}</h4>
                            <small class="text-muted">Active Users</small>
                        </div>
                        <div class="col-6">
                            <h4 class="text-warning">{{ tenant.products|filter(p => p.active)|length }}</h4>
                            <small class="text-muted">Active Products</small>
                        </div>
                    </div>
                </div>
            </div>

            {% if tenant.users|length > 0 or tenant.products|length > 0 %}
                <div class="card mt-4 border-danger">
                    <div class="card-header bg-danger text-white">
                        <h5><i class="bi bi-exclamation-triangle"></i> Danger Zone</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small">
                            This tenant cannot be deleted because it has associated users or products.
                        </p>
                        <button class="btn btn-outline-danger btn-sm" disabled>
                            <i class="bi bi-trash"></i> Delete Tenant
                        </button>
                    </div>
                </div>
            {% else %}
                <div class="card mt-4 border-danger">
                    <div class="card-header bg-danger text-white">
                        <h5><i class="bi bi-exclamation-triangle"></i> Danger Zone</h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small">
                            Permanently delete this tenant. This action cannot be undone.
                        </p>
                        <form method="post" action="{{ path('admin_tenant_delete', {id: tenant.id}) }}" 
                              onsubmit="return confirm('Are you sure you want to delete this tenant? This action cannot be undone.')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_tenant_' ~ tenant.id) }}">
                            <button type="submit" class="btn btn-danger btn-sm">
                                <i class="bi bi-trash"></i> Delete Tenant
                            </button>
                        </form>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}