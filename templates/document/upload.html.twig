{% extends 'base.html.twig' %}

{% block title %}Upload Document - {{ tenant.name }}{% endblock %}

{% use '_tenant_navigation.html.twig' %}

{% block body %}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">
                        <i class="bi bi-cloud-upload me-2"></i>
                        Upload Document
                        <small class="text-muted">{{ tenant.name }}</small>
                    </h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>
                        <strong>Tenant-Isolated Storage:</strong> Files uploaded here will be stored in a tenant-specific directory 
                        and will only be accessible within this tenant context. Other tenants cannot access these files.
                    </div>

                    <form method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="file" class="form-label">
                                <i class="bi bi-file-earmark me-1"></i>
                                Select File <span class="text-danger">*</span>
                            </label>
                            <input type="file" class="form-control" id="file" name="file" required>
                            <div class="form-text">
                                Choose any file to upload. The system will automatically detect the file type and size.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="name" class="form-label">
                                <i class="bi bi-tag me-1"></i>
                                Document Name
                            </label>
                            <input type="text" class="form-control" id="name" name="name" 
                                   placeholder="Enter a descriptive name (leave empty to use filename)">
                            <div class="form-text">
                                If left empty, the original filename will be used as the document name.
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="description" class="form-label">
                                <i class="bi bi-card-text me-1"></i>
                                Description
                            </label>
                            <textarea class="form-control" id="description" name="description" rows="3" 
                                      placeholder="Optional description of the document"></textarea>
                            <div class="form-text">
                                Provide additional context or notes about this document.
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="{{ path('tenant_document_index', {tenantSlug: tenant.slug}) }}" class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-1"></i>
                                Back to Documents
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-cloud-upload me-1"></i>
                                Upload Document
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Storage Information -->
            <div class="card mt-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        Storage Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6><i class="bi bi-shield-check text-success me-1"></i> Security Features</h6>
                            <ul class="list-unstyled">
                                <li><i class="bi bi-check text-success me-1"></i> Tenant-isolated storage</li>
                                <li><i class="bi bi-check text-success me-1"></i> Automatic file type detection</li>
                                <li><i class="bi bi-check text-success me-1"></i> Unique filename generation</li>
                                <li><i class="bi bi-check text-success me-1"></i> Cross-tenant access protection</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6><i class="bi bi-gear text-primary me-1"></i> Technical Details</h6>
                            <ul class="list-unstyled">
                                <li><i class="bi bi-folder text-warning me-1"></i> Storage path: <code>/var/uploads/tenant_{{ tenant.slug }}/</code></li>
                                <li><i class="bi bi-database text-info me-1"></i> Metadata stored in database</li>
                                <li><i class="bi bi-file-earmark text-secondary me-1"></i> Original filename preserved</li>
                                <li><i class="bi bi-clock text-muted me-1"></i> Upload timestamp recorded</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}