{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} - {{ tenant.name }}{% endblock %}

{% block navbar_extra %}
    <ul class="navbar-nav">
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                <i class="bi bi-building"></i> {{ tenant.name }}
            </a>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="{{ path('tenant_dashboard', {tenantSlug: tenant.slug}) }}">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a></li>
                <li><a class="dropdown-item" href="{{ path('tenant_product_index', {tenantSlug: tenant.slug}) }}">
                    <i class="bi bi-box"></i> Products
                </a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="{{ path('app_homepage') }}">
                    <i class="bi bi-arrow-left"></i> Back to Home
                </a></li>
            </ul>
        </li>
    </ul>
{% endblock %}

{% block body %}
<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1><i class="bi bi-box"></i> {{ product.name }}</h1>
                    <p class="text-muted">Product details for {{ tenant.name }}</p>
                </div>
                <div class="btn-group">
                    <a href="{{ path('tenant_product_edit', {tenantSlug: tenant.slug, id: product.id}) }}" class="btn btn-primary">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    <a href="{{ path('tenant_product_index', {tenantSlug: tenant.slug}) }}" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Back to Products
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5><i class="bi bi-info-circle"></i> Product Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Name:</dt>
                        <dd class="col-sm-9">{{ product.name }}</dd>
                        
                        <dt class="col-sm-3">SKU:</dt>
                        <dd class="col-sm-9"><code>{{ product.sku }}</code></dd>
                        
                        {% if product.description %}
                            <dt class="col-sm-3">Description:</dt>
                            <dd class="col-sm-9">{{ product.description|nl2br }}</dd>
                        {% endif %}
                        
                        <dt class="col-sm-3">Price:</dt>
                        <dd class="col-sm-9">
                            <span class="h4 text-primary">${{ product.price }}</span>
                        </dd>
                        
                        <dt class="col-sm-3">Stock Quantity:</dt>
                        <dd class="col-sm-9">
                            {% if product.stockQuantity > 0 %}
                                <span class="badge bg-success fs-6">{{ product.stockQuantity }} in stock</span>
                            {% else %}
                                <span class="badge bg-danger fs-6">Out of stock</span>
                            {% endif %}
                        </dd>
                        
                        <dt class="col-sm-3">Status:</dt>
                        <dd class="col-sm-9">
                            {% if product.active %}
                                <span class="badge bg-success">Active</span>
                            {% else %}
                                <span class="badge bg-secondary">Inactive</span>
                            {% endif %}
                        </dd>
                        
                        <dt class="col-sm-3">Created:</dt>
                        <dd class="col-sm-9">{{ product.createdAt|date('F j, Y \\a\\t g:i A') }}</dd>
                        
                        {% if product.updatedAt %}
                            <dt class="col-sm-3">Last Updated:</dt>
                            <dd class="col-sm-9">{{ product.updatedAt|date('F j, Y \\a\\t g:i A') }}</dd>
                        {% endif %}
                        
                        {% if product.createdBy %}
                            <dt class="col-sm-3">Created By:</dt>
                            <dd class="col-sm-9">{{ product.createdBy.fullName }}</dd>
                        {% endif %}
                    </dl>
                </div>
            </div>

            {% if product.stockQuantity <= 10 and product.stockQuantity > 0 %}
                <div class="alert alert-warning mt-4">
                    <i class="bi bi-exclamation-triangle"></i>
                    <strong>Low Stock Warning:</strong> This product has only {{ product.stockQuantity }} items remaining in stock.
                </div>
            {% elseif product.stockQuantity == 0 %}
                <div class="alert alert-danger mt-4">
                    <i class="bi bi-x-circle"></i>
                    <strong>Out of Stock:</strong> This product is currently out of stock.
                </div>
            {% endif %}
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5><i class="bi bi-lightning"></i> Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="{{ path('tenant_product_edit', {tenantSlug: tenant.slug, id: product.id}) }}" class="btn btn-primary">
                            <i class="bi bi-pencil"></i> Edit Product
                        </a>
                        <a href="{{ path('tenant_product_new', {tenantSlug: tenant.slug}) }}" class="btn btn-outline-success">
                            <i class="bi bi-plus-circle"></i> Add New Product
                        </a>
                        <a href="{{ path('tenant_product_index', {tenantSlug: tenant.slug}) }}" class="btn btn-outline-secondary">
                            <i class="bi bi-list"></i> View All Products
                        </a>
                        <a href="{{ path('tenant_dashboard', {tenantSlug: tenant.slug}) }}" class="btn btn-outline-info">
                            <i class="bi bi-speedometer2"></i> Tenant Dashboard
                        </a>
                    </div>
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header">
                    <h5><i class="bi bi-bar-chart"></i> Product Stats</h5>
                </div>
                <div class="card-body text-center">
                    <div class="row">
                        <div class="col-12 mb-3">
                            <h3 class="text-primary">${{ product.price }}</h3>
                            <small class="text-muted">Current Price</small>
                        </div>
                        <div class="col-12 mb-3">
                            <h3 class="text-info">{{ product.stockQuantity }}</h3>
                            <small class="text-muted">Units in Stock</small>
                        </div>
                        <div class="col-12">
                            <h3 class="text-success">${{ (product.priceAsFloat * product.stockQuantity)|number_format(2) }}</h3>
                            <small class="text-muted">Total Inventory Value</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header">
                    <h5><i class="bi bi-building"></i> Tenant Context</h5>
                </div>
                <div class="card-body">
                    <p class="small text-muted">
                        This product belongs to <strong>{{ tenant.name }}</strong> and is only visible 
                        within this tenant's context. Other tenants cannot see or access this product.
                    </p>
                    <a href="{{ path('tenant_dashboard', {tenantSlug: tenant.slug}) }}" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-building"></i> View Tenant
                    </a>
                </div>
            </div>

            <div class="card mt-4 border-danger">
                <div class="card-header bg-danger text-white">
                    <h5><i class="bi bi-exclamation-triangle"></i> Danger Zone</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small">
                        Permanently delete this product. This action cannot be undone.
                    </p>
                    <form method="post" action="{{ path('tenant_product_delete', {tenantSlug: tenant.slug, id: product.id}) }}" 
                          onsubmit="return confirm('Are you sure you want to delete this product? This action cannot be undone.')">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_product_' ~ product.id) }}">
                        <button type="submit" class="btn btn-danger btn-sm">
                            <i class="bi bi-trash"></i> Delete Product
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}