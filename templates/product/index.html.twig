{% extends 'base.html.twig' %}

{% block title %}Products - {{ tenant.name }}{% endblock %}

{% block navbar_extra %}
    <ul class="navbar-nav">
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                <i class="bi bi-building"></i> {{ tenant.name }}
            </a>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="{{ path('tenant_dashboard', {tenantSlug: tenant.slug}) }}">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a></li>
                <li><a class="dropdown-item" href="{{ path('tenant_product_index', {tenantSlug: tenant.slug}) }}">
                    <i class="bi bi-box"></i> Products
                </a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="{{ path('app_homepage') }}">
                    <i class="bi bi-arrow-left"></i> Back to Home
                </a></li>
            </ul>
        </li>
    </ul>
{% endblock %}

{% block body %}
<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1><i class="bi bi-box"></i> Products</h1>
                    <p class="text-muted">Manage products for {{ tenant.name }}</p>
                </div>
                <a href="{{ path('tenant_product_new', {tenantSlug: tenant.slug}) }}" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Add New Product
                </a>
            </div>
        </div>
    </div>

    {% if products is empty %}
        <div class="row">
            <div class="col-12">
                <div class="text-center py-5">
                    <i class="bi bi-box" style="font-size: 4rem; color: #ccc;"></i>
                    <h3 class="mt-3">No Products Found</h3>
                    <p class="text-muted">This tenant doesn't have any products yet.</p>
                    <a href="{{ path('tenant_product_new', {tenantSlug: tenant.slug}) }}" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Create First Product
                    </a>
                </div>
            </div>
        </div>
    {% else %}
        <div class="row">
            {% for product in products %}
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title">{{ product.name }}</h5>
                                {% if product.active %}
                                    <span class="badge bg-success">Active</span>
                                {% else %}
                                    <span class="badge bg-secondary">Inactive</span>
                                {% endif %}
                            </div>
                            
                            {% if product.description %}
                                <p class="card-text text-muted">
                                    {{ product.description|slice(0, 100) }}{% if product.description|length > 100 %}...{% endif %}
                                </p>
                            {% endif %}
                            
                            <div class="row text-center mb-3">
                                <div class="col-4">
                                    <strong class="text-primary">${{ product.price }}</strong>
                                    <br><small class="text-muted">Price</small>
                                </div>
                                <div class="col-4">
                                    <strong class="text-info">{{ product.stockQuantity }}</strong>
                                    <br><small class="text-muted">Stock</small>
                                </div>
                                <div class="col-4">
                                    <strong class="text-secondary">{{ product.sku }}</strong>
                                    <br><small class="text-muted">SKU</small>
                                </div>
                            </div>
                            
                            {% if product.stockQuantity == 0 %}
                                <div class="alert alert-warning py-2 mb-3">
                                    <i class="bi bi-exclamation-triangle"></i> Out of Stock
                                </div>
                            {% elseif product.stockQuantity < 10 %}
                                <div class="alert alert-info py-2 mb-3">
                                    <i class="bi bi-info-circle"></i> Low Stock
                                </div>
                            {% endif %}
                        </div>
                        
                        <div class="card-footer">
                            <div class="btn-group w-100">
                                <a href="{{ path('tenant_product_show', {tenantSlug: tenant.slug, id: product.id}) }}" 
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-eye"></i> View
                                </a>
                                <a href="{{ path('tenant_product_edit', {tenantSlug: tenant.slug, id: product.id}) }}" 
                                   class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                            </div>
                            <small class="text-muted d-block mt-2">
                                Created {{ product.createdAt|date('M j, Y') }}
                            </small>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}