{% extends 'base.html.twig' %}

{% block title %}{{ tenant.name }} - Dashboard{% endblock %}

{% block navbar_extra %}
    <ul class="navbar-nav">
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                <i class="bi bi-building"></i> {{ tenant.name }}
            </a>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="{{ path('tenant_dashboard', {tenantSlug: tenant.slug}) }}">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a></li>
                <li><a class="dropdown-item" href="{{ path('tenant_product_index', {tenantSlug: tenant.slug}) }}">
                    <i class="bi bi-box"></i> Products
                </a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="{{ path('app_homepage') }}">
                    <i class="bi bi-arrow-left"></i> Back to Home
                </a></li>
            </ul>
        </li>
    </ul>
{% endblock %}

{% block body %}
<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1><i class="bi bi-building"></i> {{ tenant.name }}</h1>
                    {% if tenant.description %}
                        <p class="lead">{{ tenant.description }}</p>
                    {% endif %}
                </div>
                <div>
                    <span class="badge bg-success fs-6">
                        <i class="bi bi-check-circle"></i> Active Tenant
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">{{ stats.total_products }}</h4>
                            <p class="card-text">Total Products</p>
                        </div>
                        <div class="align-self-center">
                            <i class="bi bi-box" style="font-size: 2rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">{{ stats.active_products }}</h4>
                            <p class="card-text">Active Products</p>
                        </div>
                        <div class="align-self-center">
                            <i class="bi bi-check-circle" style="font-size: 2rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">{{ stats.total_users }}</h4>
                            <p class="card-text">Total Users</p>
                        </div>
                        <div class="align-self-center">
                            <i class="bi bi-people" style="font-size: 2rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">{{ stats.active_users }}</h4>
                            <p class="card-text">Active Users</p>
                        </div>
                        <div class="align-self-center">
                            <i class="bi bi-person-check" style="font-size: 2rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Quick Actions -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5><i class="bi bi-lightning"></i> Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="{{ path('tenant_product_new', {tenantSlug: tenant.slug}) }}" class="btn btn-primary">
                            <i class="bi bi-plus-circle"></i> Add New Product
                        </a>
                        <a href="{{ path('tenant_product_index', {tenantSlug: tenant.slug}) }}" class="btn btn-outline-secondary">
                            <i class="bi bi-box"></i> View All Products
                        </a>
                    </div>
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header">
                    <h5><i class="bi bi-info-circle"></i> Tenant Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Slug:</dt>
                        <dd class="col-sm-8"><code>{{ tenant.slug }}</code></dd>
                        
                        {% if tenant.domain %}
                            <dt class="col-sm-4">Domain:</dt>
                            <dd class="col-sm-8">{{ tenant.domain }}</dd>
                        {% endif %}
                        
                        <dt class="col-sm-4">Created:</dt>
                        <dd class="col-sm-8">{{ tenant.createdAt|date('F j, Y') }}</dd>
                        
                        {% if tenant.updatedAt %}
                            <dt class="col-sm-4">Updated:</dt>
                            <dd class="col-sm-8">{{ tenant.updatedAt|date('F j, Y') }}</dd>
                        {% endif %}
                    </dl>
                </div>
            </div>
        </div>

        <!-- Recent Products -->
        <div class="col-md-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5><i class="bi bi-box"></i> Recent Products</h5>
                    <a href="{{ path('tenant_product_index', {tenantSlug: tenant.slug}) }}" class="btn btn-sm btn-outline-primary">
                        View All
                    </a>
                </div>
                <div class="card-body">
                    {% if tenant.products is empty %}
                        <div class="text-center py-4">
                            <i class="bi bi-box" style="font-size: 3rem; color: #ccc;"></i>
                            <h5 class="mt-3">No Products Yet</h5>
                            <p class="text-muted">Start by creating your first product for this tenant.</p>
                            <a href="{{ path('tenant_product_new', {tenantSlug: tenant.slug}) }}" class="btn btn-primary">
                                <i class="bi bi-plus-circle"></i> Create First Product
                            </a>
                        </div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>SKU</th>
                                        <th>Price</th>
                                        <th>Stock</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for product in tenant.products|slice(0, 5) %}
                                        <tr>
                                            <td>
                                                <strong>{{ product.name }}</strong>
                                                {% if product.description %}
                                                    <br><small class="text-muted">{{ product.description|slice(0, 40) }}{% if product.description|length > 40 %}...{% endif %}</small>
                                                {% endif %}
                                            </td>
                                            <td><code>{{ product.sku }}</code></td>
                                            <td>${{ product.price }}</td>
                                            <td>
                                                {% if product.stockQuantity > 0 %}
                                                    <span class="badge bg-success">{{ product.stockQuantity }}</span>
                                                {% else %}
                                                    <span class="badge bg-danger">Out of Stock</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if product.active %}
                                                    <span class="badge bg-success">Active</span>
                                                {% else %}
                                                    <span class="badge bg-secondary">Inactive</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <a href="{{ path('tenant_product_show', {tenantSlug: tenant.slug, id: product.id}) }}" 
                                                       class="btn btn-outline-primary btn-sm">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                    <a href="{{ path('tenant_product_edit', {tenantSlug: tenant.slug, id: product.id}) }}" 
                                                       class="btn btn-outline-secondary btn-sm">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}