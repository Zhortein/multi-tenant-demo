{% extends 'base.html.twig' %}

{% block title %}{{ tenant.name }} - Dashboard{% endblock %}

{% block navbar_extra %}
    <ul class="navbar-nav">
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                <i class="bi bi-building"></i> {{ tenant.name }}
            </a>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="{{ path('tenant_dashboard', {tenantSlug: tenant.slug}) }}">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a></li>
                <li><hr class="dropdown-divider"></li>
                <li><h6 class="dropdown-header">Data Management</h6></li>
                <li><a class="dropdown-item" href="{{ path('tenant_product_index', {tenantSlug: tenant.slug}) }}">
                    <i class="bi bi-box"></i> Products
                </a></li>
                <li><a class="dropdown-item" href="{{ path('tenant_document_index', {tenantSlug: tenant.slug}) }}">
                    <i class="bi bi-file-earmark-text"></i> Documents
                </a></li>
                <li><hr class="dropdown-divider"></li>
                <li><h6 class="dropdown-header">Communication</h6></li>
                <li><a class="dropdown-item" href="{{ path('tenant_notification_index', {tenantSlug: tenant.slug}) }}">
                    <i class="bi bi-bell"></i> Notifications
                </a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="{{ path('app_homepage') }}">
                    <i class="bi bi-arrow-left"></i> Back to Home
                </a></li>
            </ul>
        </li>
    </ul>
{% endblock %}

{% block body %}
<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1><i class="bi bi-building"></i> {{ tenant.name }}</h1>
                    {% if tenant.description %}
                        <p class="lead">{{ tenant.description }}</p>
                    {% endif %}
                </div>
                <div>
                    <span class="badge bg-success fs-6">
                        <i class="bi bi-check-circle"></i> Active Tenant
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">{{ stats.total_products }}</h4>
                            <p class="card-text">Total Products</p>
                        </div>
                        <div class="align-self-center">
                            <i class="bi bi-box" style="font-size: 2rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">{{ stats.active_products }}</h4>
                            <p class="card-text">Active Products</p>
                        </div>
                        <div class="align-self-center">
                            <i class="bi bi-check-circle" style="font-size: 2rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">{{ stats.total_users }}</h4>
                            <p class="card-text">Total Users</p>
                        </div>
                        <div class="align-self-center">
                            <i class="bi bi-people" style="font-size: 2rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">{{ stats.active_users }}</h4>
                            <p class="card-text">Active Users</p>
                        </div>
                        <div class="align-self-center">
                            <i class="bi bi-person-check" style="font-size: 2rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- New Features Statistics -->
    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">{{ storage_stats.total_files ?? 0 }}</h4>
                            <p class="card-text">Documents Stored</p>
                            <small>{{ storage_stats.formatted_size ?? '0 B' }}</small>
                        </div>
                        <div class="align-self-center">
                            <i class="bi bi-file-earmark-text" style="font-size: 2rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card text-white bg-secondary">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">{{ notification_stats.total ?? 0 }}</h4>
                            <p class="card-text">Notifications</p>
                            <small>{{ notification_stats.unread ?? 0 }} unread</small>
                        </div>
                        <div class="align-self-center">
                            <i class="bi bi-bell" style="font-size: 2rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <!-- Quick Actions -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5><i class="bi bi-lightning"></i> Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="{{ path('tenant_product_new', {tenantSlug: tenant.slug}) }}" class="btn btn-primary">
                            <i class="bi bi-plus-circle"></i> Add New Product
                        </a>
                        <a href="{{ path('tenant_product_index', {tenantSlug: tenant.slug}) }}" class="btn btn-outline-secondary">
                            <i class="bi bi-box"></i> View All Products
                        </a>
                        <hr>
                        <a href="{{ path('tenant_document_upload', {tenantSlug: tenant.slug}) }}" class="btn btn-info">
                            <i class="bi bi-cloud-upload"></i> Upload Document
                        </a>
                        <a href="{{ path('tenant_notification_create', {tenantSlug: tenant.slug}) }}" class="btn btn-warning">
                            <i class="bi bi-bell"></i> Create Notification
                        </a>
                    </div>
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-header">
                    <h5><i class="bi bi-info-circle"></i> Tenant Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Slug:</dt>
                        <dd class="col-sm-8"><code>{{ tenant.slug }}</code></dd>
                        
                        {% if tenant.domain %}
                            <dt class="col-sm-4">Domain:</dt>
                            <dd class="col-sm-8">{{ tenant.domain }}</dd>
                        {% endif %}
                        
                        <dt class="col-sm-4">Created:</dt>
                        <dd class="col-sm-8">{{ tenant.createdAt|date('F j, Y') }}</dd>
                        
                        {% if tenant.updatedAt %}
                            <dt class="col-sm-4">Updated:</dt>
                            <dd class="col-sm-8">{{ tenant.updatedAt|date('F j, Y') }}</dd>
                        {% endif %}
                    </dl>
                </div>
            </div>
        </div>

        <!-- Recent Products -->
        <div class="col-md-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5><i class="bi bi-box"></i> Recent Products</h5>
                    <a href="{{ path('tenant_product_index', {tenantSlug: tenant.slug}) }}" class="btn btn-sm btn-outline-primary">
                        View All
                    </a>
                </div>
                <div class="card-body">
                    {% if tenant.products is empty %}
                        <div class="text-center py-4">
                            <i class="bi bi-box" style="font-size: 3rem; color: #ccc;"></i>
                            <h5 class="mt-3">No Products Yet</h5>
                            <p class="text-muted">Start by creating your first product for this tenant.</p>
                            <a href="{{ path('tenant_product_new', {tenantSlug: tenant.slug}) }}" class="btn btn-primary">
                                <i class="bi bi-plus-circle"></i> Create First Product
                            </a>
                        </div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>SKU</th>
                                        <th>Price</th>
                                        <th>Stock</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for product in tenant.products|slice(0, 5) %}
                                        <tr>
                                            <td>
                                                <strong>{{ product.name }}</strong>
                                                {% if product.description %}
                                                    <br><small class="text-muted">{{ product.description|slice(0, 40) }}{% if product.description|length > 40 %}...{% endif %}</small>
                                                {% endif %}
                                            </td>
                                            <td><code>{{ product.sku }}</code></td>
                                            <td>${{ product.price }}</td>
                                            <td>
                                                {% if product.stockQuantity > 0 %}
                                                    <span class="badge bg-success">{{ product.stockQuantity }}</span>
                                                {% else %}
                                                    <span class="badge bg-danger">Out of Stock</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if product.active %}
                                                    <span class="badge bg-success">Active</span>
                                                {% else %}
                                                    <span class="badge bg-secondary">Inactive</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <a href="{{ path('tenant_product_show', {tenantSlug: tenant.slug, id: product.id}) }}" 
                                                       class="btn btn-outline-primary btn-sm">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                    <a href="{{ path('tenant_product_edit', {tenantSlug: tenant.slug, id: product.id}) }}" 
                                                       class="btn btn-outline-secondary btn-sm">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Documents and Notifications -->
    <div class="row mt-4">
        <!-- Recent Documents -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5><i class="bi bi-file-earmark-text"></i> Recent Documents</h5>
                    <a href="{{ path('tenant_document_index', {tenantSlug: tenant.slug}) }}" class="btn btn-sm btn-outline-info">
                        View All
                    </a>
                </div>
                <div class="card-body">
                    {% if recent_documents is empty %}
                        <div class="text-center py-4">
                            <i class="bi bi-file-earmark-text" style="font-size: 3rem; color: #ccc;"></i>
                            <h6 class="mt-3">No Documents Yet</h6>
                            <p class="text-muted mb-3">Upload your first document to get started.</p>
                            <a href="{{ path('tenant_document_upload', {tenantSlug: tenant.slug}) }}" class="btn btn-info btn-sm">
                                <i class="bi bi-cloud-upload"></i> Upload Document
                            </a>
                        </div>
                    {% else %}
                        <div class="list-group list-group-flush">
                            {% for document in recent_documents %}
                                <div class="list-group-item d-flex justify-content-between align-items-start">
                                    <div class="ms-2 me-auto">
                                        <div class="fw-bold">
                                            <i class="bi bi-file-earmark-text text-info me-1"></i>
                                            {{ document.name }}
                                        </div>
                                        <small class="text-muted">
                                            {{ document.originalFilename }} • {{ document.formattedFileSize }}
                                            <br>
                                            Uploaded {{ document.createdAt|date('M j, Y \\a\\t g:i A') }}
                                        </small>
                                    </div>
                                    <div class="btn-group btn-group-sm">
                                        <a href="{{ path('tenant_document_show', {tenantSlug: tenant.slug, id: document.id}) }}" 
                                           class="btn btn-outline-info btn-sm" title="View Document">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="{{ path('tenant_document_download', {tenantSlug: tenant.slug, id: document.id}) }}" 
                                           class="btn btn-outline-success btn-sm" title="Download">
                                            <i class="bi bi-download"></i>
                                        </a>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                        {% if recent_documents|length >= 5 %}
                            <div class="card-footer text-center">
                                <a href="{{ path('tenant_document_index', {tenantSlug: tenant.slug}) }}" class="btn btn-sm btn-outline-info">
                                    <i class="bi bi-arrow-right"></i> View All Documents
                                </a>
                            </div>
                        {% endif %}
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Recent Notifications -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5><i class="bi bi-bell"></i> Recent Notifications</h5>
                    <div>
                        {% if unread_notifications_count > 0 %}
                            <span class="badge bg-warning me-2">{{ unread_notifications_count }} unread</span>
                        {% endif %}
                        <a href="{{ path('tenant_notification_index', {tenantSlug: tenant.slug}) }}" class="btn btn-sm btn-outline-secondary">
                            View All
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    {% if recent_notifications is empty %}
                        <div class="text-center py-4">
                            <i class="bi bi-bell" style="font-size: 3rem; color: #ccc;"></i>
                            <h6 class="mt-3">No Notifications Yet</h6>
                            <p class="text-muted mb-3">Create your first notification to get started.</p>
                            <a href="{{ path('tenant_notification_create', {tenantSlug: tenant.slug}) }}" class="btn btn-warning btn-sm">
                                <i class="bi bi-plus-circle"></i> Create Notification
                            </a>
                        </div>
                    {% else %}
                        <div class="list-group list-group-flush">
                            {% for notification in recent_notifications %}
                                <div class="list-group-item {% if not notification.isRead and notification.sendInApp %}list-group-item-warning{% endif %}">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="ms-2 me-auto">
                                            <div class="fw-bold">
                                                <i class="{{ notification.bootstrapIcon }} text-{{ notification.bootstrapClass }} me-1"></i>
                                                {{ notification.title }}
                                                {% if not notification.isRead and notification.sendInApp %}
                                                    <span class="badge bg-warning ms-1">New</span>
                                                {% endif %}
                                            </div>
                                            <p class="mb-1">{{ notification.message|slice(0, 100) }}{% if notification.message|length > 100 %}...{% endif %}</p>
                                            <small class="text-muted">
                                                {{ notification.createdAt|date('M j, Y \\a\\t g:i A') }}
                                                {% if notification.sendEmail %}
                                                    • <i class="bi bi-envelope text-info" title="Email sent"></i>
                                                {% endif %}
                                                {% if notification.status == 'sent' %}
                                                    • <span class="text-success">Delivered</span>
                                                {% elseif notification.status == 'failed' %}
                                                    • <span class="text-danger">Failed</span>
                                                {% endif %}
                                            </small>
                                        </div>
                                        <div class="btn-group btn-group-sm">
                                            <a href="{{ path('tenant_notification_show', {tenantSlug: tenant.slug, id: notification.id}) }}" 
                                               class="btn btn-outline-secondary btn-sm" title="View Notification">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            {% if not notification.isRead and notification.sendInApp %}
                                                <form method="post" action="{{ path('tenant_notification_read', {tenantSlug: tenant.slug, id: notification.id}) }}" class="d-inline">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('read_notification_' ~ notification.id) }}">
                                                    <button type="submit" class="btn btn-outline-success btn-sm" title="Mark as Read">
                                                        <i class="bi bi-check"></i>
                                                    </button>
                                                </form>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                        {% if recent_notifications|length >= 5 %}
                            <div class="card-footer text-center">
                                <a href="{{ path('tenant_notification_index', {tenantSlug: tenant.slug}) }}" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-arrow-right"></i> View All Notifications
                                </a>
                            </div>
                        {% endif %}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Access Actions -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5><i class="bi bi-lightning-charge"></i> Quick Access</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="d-grid">
                                <a href="{{ path('tenant_document_upload', {tenantSlug: tenant.slug}) }}" class="btn btn-info">
                                    <i class="bi bi-cloud-upload"></i> Upload Document
                                </a>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="d-grid">
                                <a href="{{ path('tenant_notification_create', {tenantSlug: tenant.slug}) }}" class="btn btn-warning">
                                    <i class="bi bi-bell"></i> Create Notification
                                </a>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="d-grid">
                                <a href="{{ path('tenant_product_new', {tenantSlug: tenant.slug}) }}" class="btn btn-primary">
                                    <i class="bi bi-plus-circle"></i> Add Product
                                </a>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="d-grid">
                                <a href="{{ path('tenant_dashboard', {tenantSlug: tenant.slug}) }}" class="btn btn-outline-secondary">
                                    <i class="bi bi-arrow-clockwise"></i> Refresh Dashboard
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}