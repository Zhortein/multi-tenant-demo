{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard - Multi-Tenant Demo{% endblock %}

{% block body %}
<div class="container">
    <div class="row">
        <div class="col-12">
            <h1><i class="bi bi-speedometer2"></i> Admin Dashboard</h1>
            <p class="lead">System-wide administration and tenant management.</p>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">{{ stats.total_tenants }}</h4>
                            <p class="card-text">Total Tenants</p>
                        </div>
                        <div class="align-self-center">
                            <i class="bi bi-buildings" style="font-size: 2rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">{{ stats.active_tenants }}</h4>
                            <p class="card-text">Active Tenants</p>
                        </div>
                        <div class="align-self-center">
                            <i class="bi bi-check-circle" style="font-size: 2rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <h4 class="card-title">{{ stats.inactive_tenants }}</h4>
                            <p class="card-text">Inactive Tenants</p>
                        </div>
                        <div class="align-self-center">
                            <i class="bi bi-pause-circle" style="font-size: 2rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Quick Actions -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5><i class="bi bi-lightning"></i> Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="{{ path('admin_tenant_new') }}" class="btn btn-primary">
                            <i class="bi bi-plus-circle"></i> Create New Tenant
                        </a>
                        <a href="{{ path('admin_tenant_index') }}" class="btn btn-outline-secondary">
                            <i class="bi bi-list"></i> View All Tenants
                        </a>
                        <a href="{{ path('app_homepage') }}" class="btn btn-outline-info">
                            <i class="bi bi-house"></i> Back to Homepage
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Tenants -->
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5><i class="bi bi-clock-history"></i> Recent Tenants</h5>
                </div>
                <div class="card-body">
                    {% if recent_tenants is empty %}
                        <p class="text-muted">No tenants created yet.</p>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Slug</th>
                                        <th>Status</th>
                                        <th>Created</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for tenant in recent_tenants %}
                                        <tr>
                                            <td>
                                                <strong>{{ tenant.name }}</strong>
                                                {% if tenant.description %}
                                                    <br><small class="text-muted">{{ tenant.description|slice(0, 50) }}{% if tenant.description|length > 50 %}...{% endif %}</small>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <code>{{ tenant.slug }}</code>
                                            </td>
                                            <td>
                                                {% if tenant.active %}
                                                    <span class="badge bg-success">Active</span>
                                                {% else %}
                                                    <span class="badge bg-secondary">Inactive</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <small>{{ tenant.createdAt|date('M j, Y') }}</small>
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <a href="{{ path('admin_tenant_show', {id: tenant.id}) }}" 
                                                       class="btn btn-outline-primary btn-sm">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                    {% if tenant.active %}
                                                        <a href="{{ path('tenant_dashboard', {tenantSlug: tenant.slug}) }}" 
                                                           class="btn btn-outline-success btn-sm">
                                                            <i class="bi bi-arrow-right"></i>
                                                        </a>
                                                    {% endif %}
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}